<?xml version="1.0" encoding="utf-8"?>
<!-- The window theme under Compose: dark, no action bar, the background of Theme.kt so launch shows no white flash. -->
<resources>
    <style name="Theme.KrinikTribit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/krinik_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
